{
	"name": "df_transformacion_ames",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "PostgreSQL_amesdbtemp",
						"type": "DatasetReference"
					},
					"name": "srcAmesdbtemp"
				},
				{
					"dataset": {
						"referenceName": "csv_amesproperty",
						"type": "DatasetReference"
					},
					"name": "srcAmesproperty"
				},
				{
					"dataset": {
						"referenceName": "PostgreSQL_FloorDetail",
						"type": "DatasetReference"
					},
					"name": "srcFloorDetail"
				},
				{
					"dataset": {
						"referenceName": "cp_garage_raw",
						"type": "DatasetReference"
					},
					"name": "srcGarage"
				},
				{
					"dataset": {
						"referenceName": "cp_bsmt_raw",
						"type": "DatasetReference"
					},
					"name": "srcBsmt"
				},
				{
					"dataset": {
						"referenceName": "cp_pool_raw",
						"type": "DatasetReference"
					},
					"name": "srcPool"
				},
				{
					"dataset": {
						"referenceName": "cp_misc_raw",
						"type": "DatasetReference"
					},
					"name": "srcMisc"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DelimitedText1",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "aggFloorDetail"
				},
				{
					"name": "join2"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "join3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          exter_cond as long,",
				"          exter_qual as long,",
				"          heating_qc as long,",
				"          kitchen_qual as long,",
				"          ms_zoning as long,",
				"          pid as string,",
				"          roof_style as string,",
				"          roof_matl as string,",
				"          exterior_1st as string,",
				"          exterior_2nd as string,",
				"          mas_vnr_type as string,",
				"          mas_vnr_area as long,",
				"          foundation as string,",
				"          heating as string,",
				"          central_air as boolean,",
				"          electrical as string,",
				"          first_flr_sf as long,",
				"          second_flr_sf as long,",
				"          low_qual_fin_sf as long,",
				"          kitchen_abvgr as long,",
				"          tot_rms_abvgrd as long,",
				"          functional as string,",
				"          fireplaces as long,",
				"          fireplace_qu as string,",
				"          paved_drive as string,",
				"          wood_deck_sf as long,",
				"          open_porch_sf as long,",
				"          enclosed_porch as long,",
				"          three_ssn_porch as long,",
				"          screen_porch as long,",
				"          fence as string,",
				"          ms_subclass as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT\\n    \"Exter Cond\"       AS exter_cond,\\n    \"Exter Qual\"       AS exter_qual,\\n    \"Heating QC\"       AS heating_qc,\\n    \"Kitchen Qual\"     AS kitchen_qual,\\n    \"MS Zoning\"        AS ms_zoning,\\n    CAST(\"pid\" AS TEXT) AS pid,\\n    \"Roof Style\"       AS roof_style,\\n    \"Roof Matl\"        AS roof_matl,\\n    \"Exterior 1st\"     AS exterior_1st,\\n    \"Exterior 2nd\"     AS exterior_2nd,\\n    \"Mas Vnr Type\"     AS mas_vnr_type,\\n    \"Mas Vnr Area\"     AS mas_vnr_area,\\n    \"foundation\"       AS foundation,\\n    \"heating\"          AS heating,\\n    \"Central Air\"      AS central_air,\\n    \"electrical\"       AS electrical,\\n    \"1st Flr SF\"       AS first_flr_sf,\\n    \"2nd Flr SF\"       AS second_flr_sf,\\n    \"Low Qual Fin SF\"  AS low_qual_fin_sf,\\n    \"Kitchen AbvGr\"    AS kitchen_abvgr,\\n    \"TotRms AbvGrd\"    AS tot_rms_abvgrd,\\n    \"functional\"       AS functional,\\n    \"fireplaces\"       AS fireplaces,\\n    \"Fireplace Qu\"     AS fireplace_qu,\\n    \"Paved Drive\"      AS paved_drive,\\n    \"Wood Deck SF\"     AS wood_deck_sf,\\n    \"Open Porch SF\"    AS open_porch_sf,\\n    \"Enclosed Porch\"   AS enclosed_porch,\\n    \"3Ssn Porch\"       AS three_ssn_porch,\\n    \"Screen Porch\"     AS screen_porch,\\n    \"fence\"            AS fence,\\n    \"MS SubClass\"      AS ms_subclass\\nFROM public.amesdbtemp',",
				"     format: 'query') ~> srcAmesdbtemp",
				"source(output(",
				"          PID as string,",
				"          {Lot Frontage} as string,",
				"          {Lot Area} as string,",
				"          Street as string,",
				"          Alley as string,",
				"          {Lot Shape} as string,",
				"          {Land Contour} as string,",
				"          Utilities as string,",
				"          {Lot Config} as string,",
				"          {Land Slope} as string,",
				"          Neighborhood as string,",
				"          {Condition 1} as string,",
				"          {Condition 2} as string,",
				"          {Bldg Type} as string,",
				"          {House Style} as string,",
				"          {Overall Qual} as string,",
				"          {Overall Cond} as string,",
				"          {Year Built} as string,",
				"          {Year Remod/Add} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcAmesproperty",
				"source(output(",
				"          pid as string,",
				"          floor as long,",
				"          bedrooms as integer,",
				"          full_bath as integer,",
				"          half_bath as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT\\n    CAST(\"pid\" AS TEXT) AS pid,\\n    \"Floor\" AS floor,\\n    \"bedrooms\" AS bedrooms,\\n    \"Full Bath\" AS full_bath,\\n    \"Half Bath\" AS half_bath\\nFROM public.FloorDetail',",
				"     format: 'query') ~> srcFloorDetail",
				"source(output(",
				"          pid as string,",
				"          garage_type as string,",
				"          garage_yr_blt as string,",
				"          garage_finish as string,",
				"          garage_cars as string,",
				"          garage_area as string,",
				"          garage_qual as string,",
				"          garage_cond as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcGarage",
				"source(output(",
				"          pid as string,",
				"          bsmt_qual as string,",
				"          bsmt_cond as string,",
				"          bsmt_exposure as string,",
				"          bsmtfin_type_1 as string,",
				"          bsmtfin_sf_1 as string,",
				"          bsmtfin_type_2 as string,",
				"          bsmtfin_sf_2 as string,",
				"          bsmt_unf_sf as string,",
				"          total_bsmt_sf as string,",
				"          bsmt_full_bath as string,",
				"          bsmt_half_bath as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcBsmt",
				"source(output(",
				"          pid as string,",
				"          pool_area as string,",
				"          pool_qc as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcPool",
				"source(output(",
				"          pid as string,",
				"          misc_feature as string,",
				"          misc_val as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcMisc",
				"srcAmesproperty, srcAmesdbtemp join(srcAmesproperty@PID == srcAmesdbtemp@pid,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"srcFloorDetail aggregate(groupBy(pid),",
				"     total_bedrooms = sum(toInteger(bedrooms)),",
				"          total_full_bath = sum(toInteger(full_bath)),",
				"          total_half_bath = sum(toInteger(half_bath))) ~> aggFloorDetail",
				"srcAmesdbtemp, aggFloorDetail join(srcAmesdbtemp@pid == aggFloorDetail@pid,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"join2 derive(Gr_liv_area = toInteger(byName('1st Flr SF')) + toInteger(byName('2nd Flr SF')) + toInteger(byName('Low Qual Fin SF'))) ~> derivedColumn1",
				"derivedColumn1 join(ERROR_FUNCTION('') == ERROR_FUNCTION(''),",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join3",
				"join3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}