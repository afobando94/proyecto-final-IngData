			"type": "string",
			"defaultValue": "ep-super-fire-a8k4kvnt-pooler.eastus2.azure.neon.tech"
		},
		"AzurePostgreSql1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"AzurePostgreSql1_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "user_practica_etl1"
		},
		"MongoConn_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "test"
		}
